AI_PROVIDER=ollama
AI_FALLBACK_PROVIDER=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
# Required only when OLLAMA_URL=https://ollama.com. Never commit a real key.
OLLAMA_API_KEY=

# Optional cloud provider. ProofIQ does not need this when using Ollama.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DJANGO_SECRET_KEY=replace-this-for-production
DJANGO_DEBUG=true
